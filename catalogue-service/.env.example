# Required. At least 32 characters. Used by docker compose via env_file.
SESSION_SECRET=change-me-to-at-least-32-characters

# Shared library roots used by every account. Configure one or both.
MOVIES_PATH=
TV_PATH=

# Optional. Used when scanning libraries for TMDB metadata.
TMDB_API_KEY=

PORT=3000

# Session cookie lifetime in milliseconds. 3600000 = 60 minutes.
# Change this if a normal login should stay signed in for a different length of time.
# Restart the service after changing it.
SESSION_TTL_MS=3600000

# Remember-me cookie lifetime in milliseconds. 2592000000 = 30 days.
# Used when the user checks Remember me. Restart the service after changing it.
REMEMBER_ME_TTL_MS=2592000000
