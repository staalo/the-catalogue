meta {
  name: Ping (no auth)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/ping
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body contains Ping OK", function() {
    expect(res.getBody()).to.contain("Ping OK");
  });
}
