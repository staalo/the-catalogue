meta {
  name: Register with username
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

body:json {
  {
    "email": "withusername@example.com",
    "password": "!Salasana1",
    "userName": "withusername"
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("response includes the chosen username", function() {
    expect(res.getBody().userName).to.equal("withusername");
  });
}
