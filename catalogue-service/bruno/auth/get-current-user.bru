meta {
  name: Get Current User (auth required)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/getcurrentuser
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has email", function() {
    expect(res.getBody()).to.have.property("email");
  });
}
