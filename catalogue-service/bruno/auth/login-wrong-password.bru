meta {
  name: Login - wrong password (expect 401)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/userlogin
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@local.dev",
    "password": "wrongpassword"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}
