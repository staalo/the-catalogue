meta {
  name: stream-extra-success
  type: http
  seq: 4
}

get {
  url: http://localhost:3000/api/stream/movies/1/extras/1
  body: none
  auth: none
}

assert {
  res.status: 200 | 404 | 403
}

tests {
  test("should return 200 with extra stream or 404/403 if not found", function() {
    if (res.status === 200) {
      const contentType = res.getHeader('content-type');
      expect(contentType).to.exist;
    }
  });
}
