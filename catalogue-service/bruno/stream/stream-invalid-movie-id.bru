meta {
  name: stream-invalid-movie-id
  type: http
  seq: 5
}

get {
  url: http://localhost:3000/api/stream/movies/invalid
  body: none
  auth: none
}

assert {
  res.status: 400 | 401
}

tests {
  test("should return 400 for invalid movieId", function() {
    if (res.status === 400) {
      const data = res.getBody();
      expect(data).to.have.property('error');
    }
  });
}
