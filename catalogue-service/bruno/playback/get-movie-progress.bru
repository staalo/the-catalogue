meta {
  name: Get movie playback progress
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/playback/movies
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response contains progress items", function() {
    const body = res.getBody();
    expect(body).to.have.property("items");
    expect(body.items).to.be.an("array");
  });
}
