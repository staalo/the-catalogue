meta {
  name: search-movies-no-query
  type: http
  seq: 3
}

get {
  url: http://localhost:3000/api/search/movies
  body: none
  auth: none
}

assert {
  res.status: 400
}

tests {
  test("should return 400 when query parameter is missing", function() {
    const data = res.getBody();
    expect(data).to.have.property('error');
  });
}
