meta {
  name: scan-movies-no-auth
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/api/admin/media/scan-movies
  body: none
  auth: none
}

assert {
  res.status: 401
}

tests {
  test("should return 401 Unauthorized without session", function() {
    expect(res.status).to.equal(401);
    const body = res.getBody();
    expect(body).to.have.property('error');
  });
}
